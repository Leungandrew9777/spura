# spura-engine/.env
# Database
DATABASE_URL=postgresql://spura_user:spura_password@localhost:5432/spura_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spura_db
DB_USER=spura_user
DB_PASSWORD=spura_password

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# External APIs
FOOTBALL_DATA_BASE_URL=http://www.football-data.co.uk
UNDERSTAT_API_URL=https://understat.com
FBREF_BASE_URL=https://fbref.com

# ML Model settings
MODEL_DIR=/app/models
RANDOM_STATE=42